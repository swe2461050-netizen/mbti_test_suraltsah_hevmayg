{
  "ils": [
    {
      "id": 1,
      "text": "Би ямар нэг зүйлийг дараах тохиолдолд илүү сайн ойлгодог:",
      "options": [
        {
          "text": "Туршаад үзэхэд.",
          "value": "a"
        },
        {
          "text": "Бодоод үзэхэд.",
          "value": "b"
        }
      ],
      "category": "act_ref"
    },
    {
      "id": 2,
      "text": "Надыг илүүтэйгээр нэрлэх нь:",
      "options": [
        {
          "text": "Бодит хүн.",
          "value": "a"
        },
        {
          "text": "Шинийг эрэлхийлэгч.",
          "value": "b"
        }
      ],
      "category": "sen_int"
    },
    {
      "id": 3,
      "text": "Өчигдөр юу хийснээ бодоход ихэвчлэн:",
      "options": [
        {
          "text": "Зураг, дүр төрх харагддаг.",
          "value": "a"
        },
        {
          "text": "Үг, тайлбар санагддаг.",
          "value": "b"
        }
      ],
      "category": "vis_ver"
    },
    {
      "id": 4,
      "text": "Миний хандлага:",
      "options": [
        {
          "text": "Сэдвийн дэлгэрэнгүйг ойлгодог ч ерөнхий бүтцийг будлиулж болно.",
          "value": "a"
        },
        {
          "text": "Ерөнхий бүтцийг ойлгодог ч дэлгэрэнгүйг будлиулж болно.",
          "value": "b"
        }
      ],
      "category": "seq_glo"
    },
    {
      "id": 5,
      "text": "Шинэ зүйл сурахдаа надад тус болдог нь:",
      "options": [
        {
          "text": "Ярилцах.",
          "value": "a"
        },
        {
          "text": "Бодох.",
          "value": "b"
        }
      ],
      "category": "act_ref"
    },
    {
      "id": 6,
      "text": "Хэрвээ багш байсан бол дараах хичээлийг заахыг илүүд үзнэ:",
      "options": [
        {
          "text": "Баримт, бодит амьдралын нөхцөл байдалтай холбоотой.",
          "value": "a"
        },
        {
          "text": "Санаа, онолтой холбоотой.",
          "value": "b"
        }
      ],
      "category": "sen_int"
    },
    {
      "id": 7,
      "text": "Шинэ мэдээлэл авахдаа дараах хэлбэрийг илүүд үздэг:",
      "options": [
        {
          "text": "Зураг, диаграмм, график, газрын зураг.",
          "value": "a"
        },
        {
          "text": "Бичгийн болон аман тайлбар.",
          "value": "b"
        }
      ],
      "category": "vis_ver"
    },
    {
      "id": 8,
      "text": "Ойлгосныхоо дараа:",
      "options": [
        {
          "text": "Бүх хэсгийг ойлгосны дараа бүхлийг нь ойлгодог.",
          "value": "a"
        },
        {
          "text": "Бүхлийг нь ойлгосны дараа хэсгүүд хэрхэн нийцэж байгааг хардаг.",
          "value": "b"
        }
      ],
      "category": "seq_glo"
    },
    {
      "id": 9,
      "text": "Хэцүү сэдвийг судалдаг хэсгийн ажлын бүлэгт:",
      "options": [
        {
          "text": "Үсрэн орж санаа хуваалцдаг.",
          "value": "a"
        },
        {
          "text": "Ухарч сууж сонсдог.",
          "value": "b"
        }
      ],
      "category": "act_ref"
    },
    {
      "id": 10,
      "text": "Надад илүү хялбар:",
      "options": [
        {
          "text": "Баримт сурах.",
          "value": "a"
        },
        {
          "text": "Ойлголт сурах.",
          "value": "b"
        }
      ],
      "category": "sen_int"
    },
    {
      "id": 11,
      "text": "Зураг, диаграмм ихтэй номонд:",
      "options": [
        {
          "text": "Зураг, диаграммыг нарийвчлан харах.",
          "value": "a"
        },
        {
          "text": "Бичвэр дэх текстэд анхаарал хандуулах.",
          "value": "b"
        }
      ],
      "category": "vis_ver"
    },
    {
      "id": 12,
      "text": "Математикийн бодлого бодохдоо:",
      "options": [
        {
          "text": "Ихэвчлэн алхам алхмаар бодлогыг шийддэг.",
          "value": "a"
        },
        {
          "text": "Ихэвчлэн шийдлийг харчихдаг ч тэр хүртлэх алхмуудыг гаргахад хэцүүддэг.",
          "value": "b"
        }
      ],
      "category": "seq_glo"
    },
    {
      "id": 13,
      "text": "Авсан хичээлүүддээ:",
      "options": [
        {
          "text": "Ихэвчлэн олон оюутантай танилцдаг байсан.",
          "value": "a"
        },
        {
          "text": "Ховор тохиолдолд л олон оюутантай танилцдаг байсан.",
          "value": "b"
        }
      ],
      "category": "act_ref"
    },
    {
      "id": 14,
      "text": "Уран зохиолын бус бүтээл уншихдаа дараахыг илүүд үздэг:",
      "options": [
        {
          "text": "Шинэ баримт заадаг юм уу яаж хийхийг зааж байгааг.",
          "value": "a"
        },
        {
          "text": "Шинэ санаа өгдөгийг.",
          "value": "b"
        }
      ],
      "category": "sen_int"
    },
    {
      "id": 15,
      "text": "Дараах багшийг илүүд үздэг:",
      "options": [
        {
          "text": "Самбарт олон диаграмм зурдаг.",
          "value": "a"
        },
        {
          "text": "Тайлбарлахад их цаг зарцуулдаг.",
          "value": "b"
        }
      ],
      "category": "vis_ver"
    },
    {
      "id": 16,
      "text": "Өгүүллэг, романыг шинжлэхдээ:",
      "options": [
        {
          "text": "Үйл явдлуудыг бодож, хамтад нь нэгтгэн сэдвийг тодорхойлохыг оролддог.",
          "value": "a"
        },
        {
          "text": "Уншиж дуусаад сэдвийг мэддэг болж, дараа нь гэрчлэх үйл явдлуудыг хайж олдог.",
          "value": "b"
        }
      ],
      "category": "seq_glo"
    },
    {
      "id": 17,
      "text": "Гэрийн даалгавар эхлэхэд:",
      "options": [
        {
          "text": "Шийдэл дээр ажиллахаас шууд эхэлдэг.",
          "value": "a"
        },
        {
          "text": "Эхлэн бодлогыг бүрэн ойлгохыг хичээдэг.",
          "value": "b"
        }
      ],
      "category": "act_ref"
    },
    {
      "id": 18,
      "text": "Надад дараах санаа илүү дуртай:",
      "options": [
        {
          "text": "Тодорхой байдал.",
          "value": "a"
        },
        {
          "text": "Онол.",
          "value": "b"
        }
      ],
      "category": "sen_int"
    },
    {
      "id": 19,
      "text": "Хамгийн сайн санаж авдаг нь:",
      "options": [
        {
          "text": "Харсан зүйл.",
          "value": "a"
        },
        {
          "text": "Сонссон зүйл.",
          "value": "b"
        }
      ],
      "category": "vis_ver"
    },
    {
      "id": 20,
      "text": "Багшид хамгийн чухал:",
      "options": [
        {
          "text": "Материалыг тодорхой дараалалтай алхмуудаар тайлбарлах.",
          "value": "a"
        },
        {
          "text": "Ерөнхий дүр зургийг харуулж, материалыг бусад сэдэвтэй холбох.",
          "value": "b"
        }
      ],
      "category": "seq_glo"
    },
    {
      "id": 21,
      "text": "Дараах тохиолдолд судлахыг илүүд үздэг:",
      "options": [
        {
          "text": "Бүлгийн хэлбэрээр.",
          "value": "a"
        },
        {
          "text": "Ганцаараа.",
          "value": "b"
        }
      ],
      "category": "act_ref"
    },
    {
      "id": 22,
      "text": "Надыг дараах байдлаар тодорхойлох магадлал өндөр:",
      "options": [
        {
          "text": "Ажлынхаа дэлгэрэнгүйд нягт нямбай.",
          "value": "a"
        },
        {
          "text": "Хэрхэн хийхдээ бүтээлч.",
          "value": "b"
        }
      ],
      "category": "sen_int"
    },
    {
      "id": 23,
      "text": "Шинэ газарт очих заавар авахдаа:",
      "options": [
        {
          "text": "Газрын зургийг илүүд үздэг.",
          "value": "a"
        },
        {
          "text": "Бичгийн заавар.",
          "value": "b"
        }
      ],
      "category": "vis_ver"
    },
    {
      "id": 24,
      "text": "Сурч байгаа нь:",
      "options": [
        {
          "text": "Хэрвээ хичээвэл 'ойлгодог' жигд хурдтай.",
          "value": "a"
        },
        {
          "text": "Эхлэн төөрөлдөж, дараа нь гэнэт 'ойлгодог'.",
          "value": "b"
        }
      ],
      "category": "seq_glo"
    },
    {
      "id": 25,
      "text": "Эхлэн дараахыг хийхийг илүүд үздэг:",
      "options": [
        {
          "text": "Туршиж үзэх.",
          "value": "a"
        },
        {
          "text": "Яаж хийхийг бодох.",
          "value": "b"
        }
      ],
      "category": "act_ref"
    },
    {
      "id": 26,
      "text": "Зугаа цэнгэлд уншихдаа зохиолч:",
      "options": [
        {
          "text": "Тодорхой хэлж байгааг илүүд үздэг.",
          "value": "a"
        },
        {
          "text": "Бүтээлч, сонирхолтой байдлаар хэлэхийг илүүд үздэг.",
          "value": "b"
        }
      ],
      "category": "sen_int"
    },
    {
      "id": 27,
      "text": "Хичээлд диаграмм, зураг харахад хамгийн ихдээ санадаг нь:",
      "options": [
        {
          "text": "Зураг.",
          "value": "a"
        },
        {
          "text": "Багш түүний тухай юу гэж хэлснийг.",
          "value": "b"
        }
      ],
      "category": "vis_ver"
    },
    {
      "id": 28,
      "text": "Мэдээллийн багцыг авч үзэхдээ дараахыг хийх магадлал өндөр:",
      "options": [
        {
          "text": "Дэлгэрэнгүйд анхаарч, том зургийг алддаг.",
          "value": "a"
        },
        {
          "text": "Дэлгэрэнгүй рүү орохоос өмнө том зургийг ойлгохыг оролддог.",
          "value": "b"
        }
      ],
      "category": "seq_glo"
    },
    {
      "id": 29,
      "text": "Илүү хялбар санадаг нь:",
      "options": [
        {
          "text": "Хийсэн зүйл.",
          "value": "a"
        },
        {
          "text": "Их бодсон зүйл.",
          "value": "b"
        }
      ],
      "category": "act_ref"
    },
    {
      "id": 30,
      "text": "Даалгавар гүйцэтгэхдээ:",
      "options": [
        {
          "text": "Нэг аргыг эзэмшихийг илүүд үздэг.",
          "value": "a"
        },
        {
          "text": "Шинэ аргыг гаргахыг илүүд үздэг.",
          "value": "b"
        }
      ],
      "category": "sen_int"
    },
    {
      "id": 31,
      "text": "Хэн нэгэн өгөгдөл харуулахад:",
      "options": [
        {
          "text": "График, диаграммыг илүүд үздэг.",
          "value": "a"
        },
        {
          "text": "Үр дүнг дүгнэсэн текстийг.",
          "value": "b"
        }
      ],
      "category": "vis_ver"
    },
    {
      "id": 32,
      "text": "Эссе бичихдээ:",
      "options": [
        {
          "text": "Эхлэлд ажиллаж, урагш ахдаг.",
          "value": "a"
        },
        {
          "text": "Эссений өөр өөр хэсгүүдэд ажиллаж, дараа нь эрэмбэлдэг.",
          "value": "b"
        }
      ],
      "category": "seq_glo"
    },
    {
      "id": 33,
      "text": "Бүлгийн төсөлд ажиллахдаа эхлэн:",
      "options": [
        {
          "text": "'Бүлгийн тархи бодно' - хүн бүр санаа оруулдаг.",
          "value": "a"
        },
        {
          "text": "Тус тусдаа тархи бодоод дараа нь хамтдаа ирж харьцуулдаг.",
          "value": "b"
        }
      ],
      "category": "act_ref"
    },
    {
      "id": 34,
      "text": "Хэн нэгнийг дараахаар нэрлэх нь өндөр магтаал гэж үздэг:",
      "options": [
        {
          "text": "Хэрэгч.",
          "value": "a"
        },
        {
          "text": "Уран сэтгэмжтэй.",
          "value": "b"
        }
      ],
      "category": "sen_int"
    },
    {
      "id": 35,
      "text": "Парти дээр хүмүүстэй уулзахдаа санадаг нь:",
      "options": [
        {
          "text": "Хэрхэн харагдаж байсан.",
          "value": "a"
        },
        {
          "text": "Өөрийнхөө тухай юу гэж хэлсэн.",
          "value": "b"
        }
      ],
      "category": "vis_ver"
    },
    {
      "id": 36,
      "text": "Шинэ сэдэв судлахдаа:",
      "options": [
        {
          "text": "Тухайн сэдэвт анхаарлаа хандуулж, тухайн сэдвийн тухай аль болох ихийг мэдэхийг илүүд үздэг.",
          "value": "a"
        },
        {
          "text": "Тухайн сэдэв ба холбоотой сэдвүүдийн хоорондох холбоос тогтоохыг оролддог.",
          "value": "b"
        }
      ],
      "category": "seq_glo"
    },
    {
      "id": 37,
      "text": "Надыг дараах байдлаар тодорхойлох магадлал өндөр:",
      "options": [
        {
          "text": "Нээлттэй.",
          "value": "a"
        },
        {
          "text": "Хаалттай.",
          "value": "b"
        }
      ],
      "category": "act_ref"
    },
    {
      "id": 38,
      "text": "Дараахыг онцолсон хичээлийг илүүд үздэг:",
      "options": [
        {
          "text": "Тодорхой материал (баримт, өгөгдөл).",
          "value": "a"
        },
        {
          "text": "Хийсвэр материал (ойлголт, онол).",
          "value": "b"
        }
      ],
      "category": "sen_int"
    },
    {
      "id": 39,
      "text": "Зугаа цэнгэлд:",
      "options": [
        {
          "text": "Телевиз үзэх.",
          "value": "a"
        },
        {
          "text": "Ном унших.",
          "value": "b"
        }
      ],
      "category": "vis_ver"
    },
    {
      "id": 40,
      "text": "Зарим багш лекцийнхээ тойм хэлбэрийн дэлгэрэнгүйтэй эхэлдэг:",
      "options": [
        {
          "text": "Надад арай тусалдаг.",
          "value": "a"
        },
        {
          "text": "Надад маш их тусалдаг.",
          "value": "b"
        }
      ],
      "category": "seq_glo"
    },
    {
      "id": 41,
      "text": "Бүлгийн гэрийн даалгавар, нэг бүлэгт нэг дүн гэсэн санаа:",
      "options": [
        {
          "text": "Надад таалагддаг.",
          "value": "a"
        },
        {
          "text": "Надад таалагддаггүй.",
          "value": "b"
        }
      ],
      "category": "act_ref"
    },
    {
      "id": 42,
      "text": "Урт тооцоо хийхдээ:",
      "options": [
        {
          "text": "Бүх алхмуудаа давтаж, ажлаа нарийвчлан шалгах хандлагатай.",
          "value": "a"
        },
        {
          "text": "Ажлаа шалгах нь уйтгартай мэт санагддаг.",
          "value": "b"
        }
      ],
      "category": "sen_int"
    },
    {
      "id": 43,
      "text": "Байсан газруудаа дүрслэхдээ:",
      "options": [
        {
          "text": "Хялбар, нэлээд нарийвчлалтай.",
          "value": "a"
        },
        {
          "text": "Хэцүү, нарийвчлалгүй.",
          "value": "b"
        }
      ],
      "category": "vis_ver"
    },
    {
      "id": 44,
      "text": "Бүлэгт бодлого шийдвэрлэхдээ:",
      "options": [
        {
          "text": "Шийдлийн үйл явцын алхмуудыг боддог.",
          "value": "a"
        },
        {
          "text": "Шийдлийн боломжит үр дагавар юм уу өргөн хүрээний хэрэглэлтийг боддог.",
          "value": "b"
        }
      ],
      "category": "seq_glo"
    }
  ],
  "mbti": [
    {
      "id": 1,
      "text": "Үдэшлэг дээр та:",
      "options": [
        {
          "text": "Олон хүнтэй, тэр дундаа танихгүй хүмүүстэй ярилцдаг",
          "value": "E"
        },
        {
          "text": "Цөөн хэдэн таньдаг хүнтэйгээ л байдаг",
          "value": "I"
        }
      ],
      "category": "EI"
    },
    {
      "id": 2,
      "text": "Та илүүтэйгээр:",
      "options": [
        {
          "text": "Хоосон төсөөллөөс илүү бодит байдалд тулгуурладаг",
          "value": "S"
        },
        {
          "text": "Бодит байдлаас илүү хоосон төсөөлөлд тулгуурладаг",
          "value": "N"
        }
      ],
      "category": "SN"
    },
    {
      "id": 3,
      "text": "Аль нь илүү дээр вэ?",
      "options": [
        {
          "text": "Үүлэн дунд хөвөх (бодит байдлаас тасрах)",
          "value": "S"
        },
        {
          "text": "Нэг хэвэнд баригдах",
          "value": "N"
        }
      ],
      "category": "SN"
    },
    {
      "id": 4,
      "text": "Таныг юу илүү гайхшруулдаг вэ?",
      "options": [
        {
          "text": "Зарчим",
          "value": "T"
        },
        {
          "text": "Сэтгэл хөдлөл",
          "value": "F"
        }
      ],
